<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Allow CORS headers
    <IfModule mod_headers.c>
        Header always set Access-Control-Allow-Origin "*"
        Header always set Access-Control-Allow-Methods "GET, POST, PATCH, DELETE, OPTIONS"
        Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
    </IfModule>

    # Handle preflight OPTIONS requests
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]

    # 1. API Route Rewrites to PHP Scripts
    RewriteRule ^api/inquiries/?$ api/inquiries.php [L,QSA]
    RewriteRule ^api/reservations/?$ api/reservations.php [L,QSA]
    RewriteRule ^api/images/?$ api/images.php [L,QSA]
    RewriteRule ^api/posts/?$ api/posts.php [L,QSA]
    RewriteRule ^api/rooms/?$ api/rooms.php [L,QSA]
    RewriteRule ^api/auth/?$ api/auth.php [L,QSA]

    # 2. Prevent directory listing
    Options -Indexes

    # 3. If the actual file or directory exists, serve it directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 4. Clean URL routing for Next.js static HTML pages
    # Check if a matching .html file exists on disk (e.g. /admin/login -> /admin/login.html)
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.*)$ $1.html [L]

    # Check if a directory with index.html exists (e.g. /admin/login -> /admin/login/index.html)
    RewriteCond %{REQUEST_FILENAME}/index.html -f
    RewriteRule ^(.*)$ $1/index.html [L]

    # 5. Fallback for single-page client routing (exclude static assets)
    RewriteCond %{REQUEST_URI} !\.(css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|webp|xml|txt)$ [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]

    # Error 404 fallback
    ErrorDocument 404 /404.html
</IfModule>
